{
  "name": "marktype",
  "displayName": "Marktype",
  "description": "%extension.description%",
  "version": "0.2.2",
  "publisher": "tecacc",
  "author": {
    "name": "Connor",
    "email": "huaikang.fang@gmail.com"
  },
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tecaccc/marktype"
  },
  "bugs": {
    "url": "https://github.com/tecaccc/marktype/issues"
  },
  "homepage": "https://github.com/tecaccc/marktype#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "markdown",
    "editor",
    "wysiwyg",
    "preview",
    "visual",
    "md",
    "table",
    "tables",
    "mermaid",
    "diagram",
    "image",
    "drag-drop",
    "github-flavored-markdown",
    "gfm",
    "notion-like",
    "writing",
    "documentation",
    "readme",
    "formatting",
    "syntax-highlighting",
    "live-preview",
    "full-screen",
    "distraction-free",
    "cover-images",
    "image-resizing",
    "export",
    "html",
    "pdf",
    "docx",
    "human-friendly"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "marktype.editor",
        "displayName": "Marktype",
        "selector": [
          {
            "filenamePattern": "*.md",
            "scheme": "file"
          },
          {
            "filenamePattern": "*.markdown",
            "scheme": "file"
          },
          {
            "filenamePattern": "*.md",
            "scheme": "untitled"
          },
          {
            "filenamePattern": "*.markdown",
            "scheme": "untitled"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "marktype.openFile",
        "title": "%command.openFile.title%"
      },
      {
        "command": "marktype.outline.revealCurrent",
        "title": "%command.outline.revealCurrent.title%",
        "icon": "$(target)"
      },
      {
        "command": "marktype.outline.filter",
        "title": "%command.outline.filter.title%",
        "icon": "$(search)"
      },
      {
        "command": "marktype.outline.clearFilter",
        "title": "%command.outline.clearFilter.title%",
        "icon": "$(close)"
      },
      {
        "command": "marktype.copyAiContextRef",
        "title": "%command.copyAiContextRef.title%"
      }
    ],
    "keybindings": [
      {
        "command": "marktype.copyAiContextRef",
        "key": "alt+c",
        "mac": "alt+c",
        "when": "activeCustomEditorId == 'marktype.editor'"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "marktypeOutline",
          "name": "%view.outline.name%",
          "when": "marktype.isActive"
        }
      ]
    },
    "menus": {
      "explorer/context": [
        {
          "command": "marktype.openFile",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "marktype.openFile",
          "when": "resourceExtname == .md && activeCustomEditorId != 'marktype.editor'",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "marktype.outline.revealCurrent",
          "when": "view == marktypeOutline",
          "group": "navigation@1"
        },
        {
          "command": "marktype.outline.filter",
          "when": "view == marktypeOutline && !marktype.outlineFilterActive",
          "group": "navigation@2"
        },
        {
          "command": "marktype.outline.clearFilter",
          "when": "view == marktypeOutline && marktype.outlineFilterActive",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "Marktype",
      "properties": {
        "marktype.imagePath": {
          "type": "string",
          "default": "images",
          "description": "%configuration.imagePath.description%"
        },
        "marktype.imagePathBase": {
          "type": "string",
          "enum": [
            "relativeToDocument",
            "workspaceFolder"
          ],
          "default": "relativeToDocument",
          "description": "%configuration.imagePathBase.description%"
        },
        "marktype.chromePath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%configuration.chromePath.markdownDescription%"
        },
        "marktype.imageResize.skipWarning": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.imageResize.skipWarning.description%"
        },
        "marktype.copyAiContextRef.skipSaveWarning": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.copyAiContextRef.skipSaveWarning.description%"
        },
        "marktype.blankLines.mode": {
          "type": "string",
          "enum": [
            "preserve",
            "strip"
          ],
          "default": "strip",
          "description": "%configuration.blankLines.mode.description%"
        },
        "marktype.imagePreview.hover.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.imagePreview.hover.enabled.description%",
          "scope": "application"
        },
        "marktype.paragraph.spacingBefore": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 72,
          "description": "%configuration.paragraph.spacingBefore.description%",
          "scope": "application"
        },
        "marktype.paragraph.spacingAfter": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 72,
          "description": "%configuration.paragraph.spacingAfter.description%",
          "scope": "application"
        },
        "marktype.zoom": {
          "type": "number",
          "default": 100,
          "minimum": 50,
          "maximum": 200,
          "description": "%configuration.zoom.description%",
          "scope": "application"
        },
        "marktype.layout.maxWidth": {
          "type": "number",
          "default": 800,
          "minimum": 0,
          "maximum": 2400,
          "description": "%configuration.layout.maxWidth.description%",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build:release",
    "build:debug": "npm run build:extension:debug && npm run build:webview:debug",
    "build:release": "npm run build:extension:release && npm run build:webview:release && npm run verify-build",
    "verify-build": "node scripts/verify-build.js",
    "build:extension:debug": "node scripts/build-extension.js",
    "build:extension:release": "node scripts/build-extension.js --prod --no-sourcemap",
    "build:webview:debug": "node scripts/build-webview.js",
    "build:webview:release": "node scripts/build-webview.js --prod --no-sourcemap",
    "watch:debug": "concurrently \"npm run watch:extension:debug\" \"npm run watch:webview:debug\"",
    "watch:extension:debug": "node scripts/build-extension.js --watch",
    "watch:webview:debug": "node scripts/build-webview.js --watch",
    "lint": "eslint src --ext ts --max-warnings 0",
    "lint:fix": "eslint src --ext ts --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "precommit": "npm run lint && npm run test",
    "validate": "npm run lint && npm run test && npm run build:debug",
    "package:release": "vsce package",
    "publish:release": "vsce publish",
    "publish:ovsx:release": "npm run build:release && ovsx publish",
    "install-hooks": "bash ./scripts/install-git-hooks.sh"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@types/image-size": "^0.7.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.6",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vscode/vsce": "^3.7.1",
    "concurrently": "^8.2.2",
    "esbuild": "^0.27.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.1.1",
    "ts-jest": "^29.1.1",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@tiptap/core": "^3.0.0",
    "@tiptap/extension-code-block-lowlight": "^3.0.0",
    "@tiptap/extension-image": "^3.0.0",
    "@tiptap/extension-link": "^3.0.0",
    "@tiptap/extension-list": "^3.0.0",
    "@tiptap/extension-table": "^3.0.0",
    "@tiptap/markdown": "^3.0.0",
    "@tiptap/pm": "^3.0.0",
    "@tiptap/starter-kit": "^3.0.0",
    "@types/turndown": "^5.0.4",
    "cheerio": "^1.1.2",
    "docx": "^9.5.1",
    "highlight.js": "^11.11.1",
    "image-size": "^2.0.2",
    "katex": "^0.16.9",
    "lowlight": "^2.9.0",
    "markdown-it": "^14.0.0",
    "mermaid": "^10.6.1",
    "turndown": "^7.1.2"
  }
}
